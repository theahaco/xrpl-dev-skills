# XRPL WebSocket endpoint. Testnet by default.
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233

# Seed of the issuing account. Never commit a real seed.
ISSUER_SEED=

# Where the durable ban list is stored (JSON file). Replace with a database-backed
# BanList implementation in production.
BAN_LIST_PATH=data/ban-list.json
