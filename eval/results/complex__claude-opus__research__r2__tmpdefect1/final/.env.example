# XRPL WebSocket endpoint (testnet). Use wss:// only.
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# Expected network ID (1 = testnet). The issuer refuses to sign for any other network.
XRPL_NETWORK_ID=1
# Issuer account. Keep the seed out of source control; in production load it from a KMS/HSM.
ISSUER_ADDRESS=
ISSUER_SEED=
