{
  "name": "mpt-issuer",
  "version": "1.0.0",
  "description": "Issuer-side compliance controls for an XRPL Multi-Purpose Token",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "test": "tsx --test test/*.test.ts",
    "verify": "tsx --env-file=.env scripts/verify.ts"
  },
  "type": "module",
  "dependencies": {
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=20.6"
  }
}
