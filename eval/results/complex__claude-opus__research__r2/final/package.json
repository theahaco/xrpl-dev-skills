{
  "name": "mpt-issuer",
  "version": "1.0.0",
  "private": true,
  "description": "Issuer-side compliance controls for a regulated Multi-Purpose Token (MPT) on the XRP Ledger",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "xrpl": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
