    "demo": "tsx scripts/demo.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "xrpl": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
