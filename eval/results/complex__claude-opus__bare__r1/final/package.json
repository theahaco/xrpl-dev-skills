{
  "name": "mpt-compliance-issuer",
  "version": "1.0.0",
  "private": true,
  "description": "Issuer-side compliance controls (allowlist, clawback, bans, per-holder and global freeze) for an XRPL Multi-Purpose Token",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx --env-file=.env scripts/demo.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "xrpl": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
