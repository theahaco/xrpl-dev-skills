  "dependencies": {
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=24"
  }
