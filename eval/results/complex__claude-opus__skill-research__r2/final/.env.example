# XRPL WebSocket endpoint. Testnet only for now.
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# Expected network ID (1 = testnet). The client refuses to sign for any other network.
XRPL_NETWORK_ID=1
# Issuer account. The seed must derive to ISSUER_ADDRESS or startup fails.
ISSUER_ADDRESS=
ISSUER_SEED=
