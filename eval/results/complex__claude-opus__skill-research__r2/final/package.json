  "description": "Issuer-side compliance controls for a regulated Multi-Purpose Token (MPT) on the XRP Ledger",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "demo": "npm run build && node --env-file=.env dist/scripts/demo.js"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "private": true,
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=22"
  }
}
