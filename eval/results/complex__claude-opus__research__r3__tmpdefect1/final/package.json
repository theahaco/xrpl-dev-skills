{
  "name": "mpt-stablecoin-issuer",
  "version": "0.1.0",
  "description": "Issuer-side compliance controls for a regulated MPT stablecoin on the XRP Ledger",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "demo": "npm run build && node --env-file=.env dist/demo.js"
  },
  "type": "module",
  "dependencies": {
    "xrpl": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  },
  "private": true,
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  }
}
